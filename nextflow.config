params {
  project_folder      = "$PWD"
  bamcoverage_output  = "bamcoverage_output"

  bam_pattern         = null
  bam_list            = null   // optional TSV: sample_id <tab> bam_path
  samples_master      = null
  bam_input_dir       = null
  bamcoverage_include_controls = true

  binSize             = 20
  normalizeUsing      = "RPGC"
  effectiveGenomeSize = 2468088461
  blacklist           = null

  extendReads         = 150
  centerReads         = true
  ignoreDuplicates    = true

  smoothLength        = 60
  minMappingQuality   = 10
  samFlagExclude      = null
  scaleFactor         = null

  require_bai         = true
  extra_args          = ""

  container_deeptools = "/ictstr01/groups/idc/projects/uhlenhaut/jiang/singularity_image/deeptools-3.5.6.sif"
  extra_mounts        = ""
  mail_user           = "molendo.hpc@gmail.com"
  queue               = 'cpu_p'

  bamcoverage_cpus    = 14
  bamcoverage_memory  = "16 GB"
  bamcoverage_time    = "4h"
}

profiles {
  local {
    includeConfig "${baseDir}/configs/local.config"
  }

  hpc {
    includeConfig "${baseDir}/configs/slurm.config"
  }
}
